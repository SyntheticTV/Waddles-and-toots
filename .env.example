# Waddles and Toots — local secrets
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must
# stay that way.
#
#   cp .env.example .env
#
# IMPORTANT: everything in here is read by the scripts in `tools/` only — they
# run on your machine, at build time, in Node. None of it is read by the game,
# none of it is bundled, and none of it ships to a device. That is deliberate:
# a key inside a mobile app can always be extracted from the app, no matter how
# it is stored, so the game never holds one.
#
# (For completeness: Expo *does* support .env files, and inlines any variable
# named EXPO_PUBLIC_* into the JS bundle at build time. Those are public by
# definition — the Expo docs say so plainly — so no key ever goes in one.)

# --- text to speech -------------------------------------------------------
# Used by `npm run voices`, which records every line the crowd says into
# assets/voice/ as audio files the game then plays like any other sound.

# The endpoint the script posts to.
VOICE_API_URL=

# Fill in whichever your API uses, and delete the other.
# 1) A plain API key or bearer token:
VOICE_API_KEY=
# 2) Or the path to a Google service-account JSON file on this machine:
GOOGLE_APPLICATION_CREDENTIALS=

# Optional, if your endpoint needs them.
VOICE_PROJECT_ID=
VOICE_LOCATION=
